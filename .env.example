# Copy to .env and adjust. Every value shown is the default.

# --- Local model (any OpenAI-compatible server) ---
# Ollama: http://localhost:11434/v1   LM Studio: http://localhost:1234/v1   llama-server: http://localhost:8080/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=local
LLM_TIMEOUT=900
# Rough character budget per model call (~3.5 chars per token). The server's context window must
# hold this plus the reply: tokens >= LLM_CONTEXT_CHARS / 3.5 + LLM_MAX_TOKENS_DEEP.
LLM_CONTEXT_CHARS=24000
# Sampling preset: generic, or qwen (Qwen model-card settings for thinking / non-thinking calls)
LLM_PRESET=generic
# Optional JSON overrides, e.g. {"temperature": 0.5}
LLM_SAMPLING_FAST=
LLM_SAMPLING_DEEP=
# Thinking for "fast" calls (queries, ranking, note extraction) and "deep" calls (planning,
# coverage review, writing): off | low | medium | high | xhigh | default (send nothing)
LLM_THINK_FAST=off
LLM_THINK_DEEP=low
# How to request it: both | chat_template_kwargs | reasoning_effort | none
LLM_THINK_CONTROL=both
# Output cap per call (thinking tokens count towards it)
LLM_MAX_TOKENS_FAST=4096
LLM_MAX_TOKENS_DEEP=8192
# Stop a run after this many model calls fail in a row
LLM_MAX_CONSECUTIVE_FAILURES=3

# For Qwen 3.8 27B served with a 32K context (see README):
# LLM_PRESET=qwen
# LLM_CONTEXT_CHARS=60000

# --- Web search: searxng (recommended), duckduckgo (no setup, may rate-limit) or brave ---
SEARCH_PROVIDER=duckduckgo
SEARXNG_URL=http://localhost:8888
BRAVE_API_KEY=
SEARCH_RESULTS_PER_QUERY=8

# --- Research depth defaults (each can be overridden per topic in the UI) ---
MAX_ITERATIONS=3
MAX_QUESTIONS=5
MAX_SOURCES=25
SOURCES_PER_QUESTION=3
QUERIES_PER_QUESTION=2

# --- Misc ---
FETCH_TIMEOUT=20
MAX_PAGE_CHARS=40000
# Report passages without a citation: drop (default) or flag with [citation needed]
UNCITED_POLICY=drop
DATA_DIR=data
WORKER_CONCURRENCY=1
